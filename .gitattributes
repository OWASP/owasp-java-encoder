# Normalize repository text while preserving binary artifacts and fixtures.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.gif binary
*.ico binary
*.jar binary
*.jpg binary
*.pdf binary
*.png binary
*.zip binary

# Preserve the historical wiki snapshot byte-for-byte, including old whitespace.
docs/archive/wiki-2019/*.mediawiki -text whitespace=-blank-at-eol,-blank-at-eof
