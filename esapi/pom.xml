<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.owasp.encoder</groupId>
        <artifactId>encoder-parent</artifactId>
        <version>1.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>encoder-esapi</artifactId>
    <packaging>jar</packaging>
    <url>https://owasp.org/projects/java-encoder</url>

    <name>ESAPI Thunk</name>
    <description>
        The OWASP Encoders ESAPI Thunk provides an easy way to plugin the Encoder
        Projects API into an implementation of ESAPI.
    </description>

    <properties>
        <coverage.line.minimum>0.964</coverage.line.minimum>
        <coverage.branch.minimum>1.000</coverage.branch.minimum>
        <!-- Override with -Desapi.version to verify another supported ESAPI release. -->
        <esapi.version>2.7.0.0</esapi.version>
        <jigsaw.module.name>org.owasp.encoder.esapi</jigsaw.module.name>
        <osgi.symbolic.name>org.owasp.encoder.esapi</osgi.symbolic.name>
        <!-- Every core method this adapter calls predates 1.4, so the floor is the
             oldest supported core: 1.4.1, the security release (SECURITY.md).
             ESAPI publishes no OSGi metadata; consumers wrap it, so its packages
             stay unversioned. -->
        <osgi.import.package>
            org.owasp.encoder;version="[1.4.1,2)",
            *
        </osgi.import.package>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.owasp.encoder</groupId>
            <artifactId>encoder</artifactId>
            <version>${project.parent.version}</version>
        </dependency>
        <dependency>
            <groupId>org.owasp.esapi</groupId>
            <artifactId>esapi</artifactId>
            <version>${esapi.version}</version>
        </dependency>
        <!-- Independently parse the adapter's quoted HTML attribute output. -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Name the call sites of deprecated core APIs such as Encode.forUri. -->
                    <showDeprecation>true</showDeprecation>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-path-test-support</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/../src/test-support/java</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <adapter.bundle>${project.build.directory}/${project.build.finalName}.jar</adapter.bundle>
                        <encoder.bundle>${maven.multiModuleProjectDirectory}/core/target/encoder-${project.version}.jar</encoder.bundle>
                        <module.consumer.api.class>org.owasp.esapi.Encoder</module.consumer.api.class>
                        <module.consumer.classpath>true</module.consumer.classpath>
                        <module.consumer.main>owasp.encoder.esapi.consumer/org.owasp.encoder.consumer.EsapiConsumer</module.consumer.main>
                        <module.consumer.sources>${project.basedir}/src/test/modules/owasp.encoder.esapi.consumer</module.consumer.sources>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <id>module-path-consumer</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
